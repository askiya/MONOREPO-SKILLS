# Contoh environment variables. Copy ke .env dan isi nilai asli.
# JANGAN commit .env ke Git.

# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Auth
NEXTAUTH_SECRET=<GENERATE: openssl rand -base64 32>
NEXTAUTH_URL=http://localhost:3000

# Payment (server only — jangan pakai prefix NEXT_PUBLIC_)
XENDIT_SECRET_KEY=<FROM_PROVIDER_DASHBOARD>
XENDIT_WEBHOOK_TOKEN=<FROM_PROVIDER_DASHBOARD>

# Email
RESEND_API_KEY=<FROM_PROVIDER_DASHBOARD>
EMAIL_FROM=noreply@domain-kamu.com

# Storage
S3_ENDPOINT=<...>
S3_ACCESS_KEY_ID=<...>
S3_SECRET_ACCESS_KEY=<...>
S3_BUCKET=<...>

# Public (boleh terlihat browser — JANGAN taruh secret di sini)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Nama Produk
